{
    "name": "xiaojian-translator",
    "version": "1.1.0",
    "private": true,
    "description": "小简翻译 - 简洁优雅的桌面翻译工具",
    "main": "electron-main.js",
    "scripts": {
        "start": "node start-app.js",
        "start:web": "node -e \"const {startServer}=require('./app-server');startServer(3000).then(h=>console.log('小简翻译 Web 版已启动: '+h.url))\"",
        "desktop": "node start-app.js",
        "build:win": "electron-builder --win nsis portable",
        "pack:win": "electron-builder --dir"
    },
    "devDependencies": {
        "electron": "^31.7.7",
        "electron-builder": "^26.0.12",
        "png-to-ico": "^3.0.2",
        "sharp": "^0.35.3",
        "to-ico": "^1.1.5"
    },
    "build": {
        "appId": "com.xiaojian.translator",
        "productName": "XiaoJian-Translator",
        "artifactName": "${productName}-${version}-${arch}.${ext}",
        "asar": true,
        "electronDownload": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
        },
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "publish": {
            "provider": "github",
            "owner": "X-1784",
            "repo": "translator"
        },
        "files": [
            "assets/**/*",
            "public/**/*",
            "app-server.js",
            "electron-main.js",
            "preload.js",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "小简翻译",
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}.${ext}"
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "tesseract.js": "^7.0.0"
    }
}
