{
  "name": "translator-app",
  "version": "1.0.0",
  "private": true,
  "description": "A sleek translation web app with a lightweight Node server.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server-fixed.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "pack:win": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.fluxtranslate.desktop",
    "productName": "FluxTranslate",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "X-1784",
      "repo": "translator"
    },
    "files": [
      "assets/**/*",
      "public/**/*",
      "app-server.js",
      "electron-main.js",
      "preload.js",
      "server-fixed.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FluxTranslate",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
